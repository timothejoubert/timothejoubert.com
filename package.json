{
    "name": "timothejoubert.com",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
