        "@nuxt/image": "2.2.0",
        "@nuxtjs/i18n": "10.6.0",
        "@nuxtjs/prismic": "^5.3.1",
        "@nuxtjs/robots": "^7.0.2",
        "@nuxtjs/sitemap": "^9.1.0",
        "@prismicio/client": "^7.22.3",
        "@prismicio/vue": "^6.1.5",
        "@vueuse/nuxt": "15.0.0",
        "include-media": "^2.0.0",
        "nuxt": "4.6.2",
        "nuxt-schema-org": "^7.0.1",
        "postcss-pxtorem": "^6.1.0",
